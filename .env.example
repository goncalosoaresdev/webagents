# Bind to loopback behind a TLS reverse proxy. Use 0.0.0.0 only inside a private container network.
# Required in production or when listening outside loopback. Use at least 32 random characters.
# WEBCODE_AUTH_TOKEN=
WEBCODE_HOST=127.0.0.1
WEBCODE_PORT=8787
WEBCODE_ALLOWED_ORIGINS=https://webcode.example.com
WEBCODE_WORKSPACE_ROOT=/srv/webcode/workspaces
WEBCODE_DATA_DIR=/var/lib/webcode

WEBCODE_PROVIDER_CACHE_TTL_MS=30000
WEBCODE_PROVIDER_PROBE_TIMEOUT_MS=20000
WEBCODE_WS_TICKET_TTL_MS=30000

CODEX_BIN=codex
# CODEX_HOME=/srv/webcode/.codex
MUSE_BIN=muse
# MUSE_HOME=/srv/webcode/.muse
# META_API_KEY=
GROK_BIN=grok
# GROK_HOME=/srv/webcode/.grok
# XAI_API_KEY=
LOG_LEVEL=info
