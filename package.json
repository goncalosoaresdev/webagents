{
  "name": "webcode",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "build:server": "esbuild server/index.ts --bundle --packages=external --platform=node --format=esm --target=node22 --sourcemap --outfile=dist-node/index.js",
    "build:all": "npm run build && npm run build:server",
    "start": "vite preview",
    "start:server": "NODE_ENV=production node --env-file-if-exists=.env --enable-source-maps dist-node/index.js",
    "test": "node --import tsx --test server/*.test.ts server/core/*.test.ts server/http/*.test.ts server/security/*.test.ts server/providers/codex/*.test.ts server/providers/muse/*.test.ts server/providers/grok/*.test.ts",
    "test:providers": "node --import tsx --test server/providers/codex/*.test.ts server/providers/muse/*.test.ts server/providers/grok/*.test.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "postinstall": "node scripts/prepare-terminal.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@muse-code/sdk": "0.1.1",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fastify": "^5.12.3",
    "lucide-react": "1.31.0",
    "node-pty": "^1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "3.6.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module"
}
